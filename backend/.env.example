INDUSTRIAL_POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/anomaly_db
INDUSTRIAL_REDIS_URL=redis://localhost:6379/0
INDUSTRIAL_CELERY_BROKER_URL=redis://localhost:6379/1
INDUSTRIAL_CELERY_RESULT_BACKEND=redis://localhost:6379/2
INDUSTRIAL_MINIO_ENDPOINT=localhost:9000
INDUSTRIAL_MINIO_ACCESS_KEY=minioadmin
INDUSTRIAL_MINIO_SECRET_KEY=minioadmin
INDUSTRIAL_MINIO_BUCKET=anomaly-data
INDUSTRIAL_MINIO_SECURE=false
INDUSTRIAL_MLFLOW_TRACKING_URI=http://localhost:5001
INDUSTRIAL_DEBUG=true
INDUSTRIAL_ENVIRONMENT=development
INDUSTRIAL_EMBEDDING_DIM=384
INDUSTRIAL_EMBEDDING_MODEL=dinov2_vits14
INDUSTRIAL_CLUSTERING_MIN_SAMPLES=2
INDUSTRIAL_CLUSTERING_MIN_CLUSTER_SIZE=2
