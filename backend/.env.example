# 硅基流动 SiliconFlow：https://siliconflow.cn/
#   INDUSTRIAL_VLM_ENDPOINT=https://api.siliconflow.cn/v1
#   INDUSTRIAL_VLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# 本地 vLLM/Ollama：
INDUSTRIAL_VLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
INDUSTRIAL_VLM_MODEL=qwen-vl-max
INDUSTRIAL_VLM_API_KEY= sk-f02f3f2d7c1f449faccd27dbdcbeceb0
INDUSTRIAL_DEFAULT_DEPLOY_TARGET=production_line_a
INDUSTRIAL_DEPLOY_TARGETS={"production_line_a":"./deployed_models/line_a","production_line_b":"./deployed_models/line_b"}
INDUSTRIAL_DEPLOY_MODEL_SUBDIR=filter_classifier
INDUSTRIAL_DEPLOY_ON_TRAIN_COMPLETE=false
