FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml .
RUN uv pip install --system --no-cache \
    celery[redis]>=5.4.0 \
    redis>=5.0.0 \
    sqlalchemy[asyncio]>=2.0.30 \
    asyncpg>=0.29.0 \
    pgvector>=0.3.0 \
    numpy>=1.26.0 \
    torch>=2.3.0 \
    torchvision>=0.18.0 \
    umap-learn>=0.5.6 \
    hdbscan>=0.8.33 \
    scikit-learn>=1.5.0 \
    structlog>=24.4.0 \
    pydantic>=2.7.0 \
    pydantic-settings>=2.3.0

COPY app/ ./app/
COPY ml/ ./ml/

CMD ["celery", "-A", "app.infrastructure.queue.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
